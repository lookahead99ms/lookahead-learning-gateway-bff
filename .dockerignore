# Allow only the standalone build inputs into Docker's context.
**
!Dockerfile
!.dockerignore
!gradlew
!build.gradle
!settings.gradle
!gradle/
!gradle/wrapper/
!gradle/wrapper/gradle-wrapper.jar
!gradle/wrapper/gradle-wrapper.properties
!src/
!src/**

# Exact public JVM DNS cache configuration required by the runtime COPY.
!deployment/
!deployment/container/
!deployment/container/dns.security

# Do not admit accidental credentials or generated/private files under src/.
**/.env*
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/*.jks
**/*.keystore
**/secrets/**
**/private/**
**/*.private.*
**/.DS_Store
